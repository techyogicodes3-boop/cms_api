NODE_ENV=production
PORT=9000
DOATDASH_MONGODB_URI=mongodb+srv://username:password@cluster/database
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
CORS_ORIGINS=https://chocotraill.com,https://www.chocotraill.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax
# Use this only when API is hosted on a subdomain such as api.chocotraill.com.
# AUTH_COOKIE_DOMAIN=.chocotraill.com
ADMIN_BOOTSTRAP_NAME=Chocotraill Admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
# Set true for one deployment only if an existing admin password must be reset.
ADMIN_BOOTSTRAP_RESET_PASSWORD=false
